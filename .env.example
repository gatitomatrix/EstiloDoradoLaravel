APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@estilodorado.com"
MAIL_FROM_NAME="Estilo Dorado"

# Enlaces en correos (bienvenida, recuperar clave)
FRONTEND_URL=http://localhost:4200

# Correo REAL (opcional, gratis ~100-300/día). NO lo uses en el día a día:
# comenta el bloque Mailpit de arriba y descomenta UNO:
#
# Gmail (Contraseña de aplicación, no la clave de Gmail):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM_ADDRESS="tu-correo@gmail.com"
# MAIL_FROM_NAME="Estilo Dorado"
#
# Brevo (https://www.brevo.com — plan free):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-login-brevo
# MAIL_PASSWORD=tu-smtp-key
# MAIL_FROM_ADDRESS="no-reply@tudominio.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Asistente IA (chatbot) ---
# Local / demo: gemini (gratis). Ollama opcional si no hay key.
# rules | ollama | gemini
LLM_DRIVER=gemini
LLM_FALLBACK_RULES=true

# Ollama local (solo si LLM_DRIVER=ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=90

# Gemini (Google AI Studio) — NUNCA subas la key a GitHub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=45

# WhatsApp de la tienda (sin + ni espacios). Ej: 51987654321
WHATSAPP_NUMBER=

# --- Render (NO uses estas en tu PC; van en el panel de Render) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://estilo-dorado-api.onrender.com
# FRONTEND_URLS=*
# Enlaces de correos (bienvenida / recuperar). Cuando el .net.pe esté vivo:
# FRONTEND_URL=https://estilodorado.net.pe
# Mientras tanto:
# FRONTEND_URL=https://estilo-dorado-web.onrender.com
# Local (Mailpit): FRONTEND_URL=http://localhost:4200
# DB_CONNECTION=mysql
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# LLM_DRIVER=rules

# Culqi (NO subas sk_live a GitHub). En Render: CULQI_PUBLIC_KEY en el Static Site
# y CULQI_PRIVATE_KEY en el Web Service. Vacío = pago de demostración.
CULQI_PUBLIC_KEY=
CULQI_PRIVATE_KEY=

# Login Gmail (OAuth Web). Mismo Client ID en Angular googleClientId.
# Orígenes: http://localhost:4200 y https://estilo-dorado-web.onrender.com
GOOGLE_CLIENT_ID=
